# Line ending consistancy

* text = auto
# C++ SOURCE FILES 
# LF Linux Style ending in repo, CRLF on Windoes Checkout
*.c         text eol=lf
*.cpp               text eol=lf
*.cxx               text eol=lf
*.cc                text eol=lf
*.h                 text eol=lf
*.hpp               text eol=lf
*.hxx               text eol=lf
*.inl               text eol=lf

# RUST SOURCE FILES
*.rs                text eol=lf
*.toml              text eol=lf

# PYTHON SOURCE FILES
*.py                text eol=lf
*.pyi               text eol=lf
*.ipynb             text eol=lf

# CMAKE BUILD FILES
CMakeLists.txt      text eol=lf
*.cmake
CMakePresets.json   text eol=lf

# QT SPECIFIC FILES
*.pro               text eol=lf
*.pri               text eol=lf
*.qml               text eol=lf
*.qrc               text eol=lf
*.ui                text eol=lf

# WEB & MERN WEBSITE FILES
*.js                text eol=lf
*.jsx               text eol=lf
*.ts                text eol=lf
*.tsx               text eol=lf
*.html              text eol=lf
*.css               text eol=lf
*.scss              text eol=lf
*.json              text eol=lf
*.md                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.xml               text eol=lf
*.env               text eol=lf

# SHELL & BATCH SCRIPTS Shell scripts must have LF - CRLF will break them. Batch scripts must have CRFL - they run on Windows
*.sh                text eol=lf
*.bash              text eol=lf
*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf

# DOCS FILES
*.txt               text eol=lf
*.rst               text eol=lf
*.adoc              text eol=lf
LICENSE             text eol=lf
README*             text eol=lf
CHANGELOG*          text eol=lf
CONTRIBUTING*       text eol=lf
SECURITY*           text eol=lf

# BINARY FILE Tell git not to touch these - treat as raw bytes
# Images
*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.bmp               binary
*.ico               binary
*.svg               binary
*.webp              binary
*.tiff              binary
*.psd               binary
# Fonts 
*.tff               binary
*.otf               binary
*.woff              binary
*.woff2             binary
*.eot               binary
# Audio & Video
*.mp3               binary
*.mp4               binary
*.wav               binary
*.ogg               binary
# AI Model Weights (binary - never diff these)
*.pt                binary
*.pth               binary
*.onnx              binary
*.h5                binary
*.bin               binary
*.pkl               binary
# Archieves
*.zip               binary
*.tar               binary
*.gz                binary
*.7z                binary
*.rar               binary
# Windows Executable & Libraries
*.exe               binary
*.dll               binary
*.lib               binary
*.pdb               binary

# GITHUB LINGUISTIC SETTINGS 
# Controlls whar languages GitHub detects in repo
# Tell GitHub these are not main languages
docs/*             linguistic-documentation
website/*          linguistic-genrated=false
scripts/*.sh       linguistic-language=Shell
installer/*        linguistic-documentation
# Mark the core langauge as C++
core/*.cpp         linguistic-langauge=C++
core/*.h           linguistic-langauge=C++
ui/*.cpp           linguistic-langauge=C++