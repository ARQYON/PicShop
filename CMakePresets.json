{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SVPICSHOP_COMPANY_NAME": "ARQYON",
        "SVPICSHOP_WEBSITE": "https://ARQYON.co",
        "SVPICSHOP_AUTHOR": "Adil Hassan"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Debug - full warnings, no optimizations, tests ON",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SVPICSHOP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Release - optimized, ready to ship as SVPicShop.exe",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SVPICSHOP_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "build-release",
      "displayName": "Build Release - SVPicShop.exe",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "build-release-clean",
      "displayName": "Build Release (Clean)",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "jobs": 4,
      "cleanFirst": true
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "displayName": "Run All Tests  (Debug)",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false
      }
    },
    {
      "name": "test-release",
      "displayName": "Run All Tests (Release)",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    }
  ]
}